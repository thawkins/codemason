# Build artifacts
/target/
/benches/

# IDE
.idea/
.vscode/
*.swp
*.swo
*.iml
*.suo
*.user
.history/
*.orig
*.rej

# Logs
/log/
/logs/

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
!.env.example

# Temporary build artifacts
target/temp/
crates/*/target/
crates/*/log/
crates/*/logs/

# Coverage artifacts
*.profraw
default.profraw

# Research outputs (generated by `codemason research`)

crates/*/research/test-research-routes-*/

# Spec outputs (generated by `/spec` slash command)
#/specs/

# Stray files
EOF

# Database files
*.db
*.sqlite
*.sqlite3
# SQLite WAL/SHM sidecars and rollback journals can hold plaintext
# credential-store and session pages mid-write.
*.db-wal
*.db-shm
*.db-journal
*.sqlite-journal
*.sqlite3-journal

# Key files
*.key
id_rsa
id_rsa*
id_ecdsa
id_dsa
id_ed25519
*.ppk
*.jks
*.keystore
# Cargo registry tokens live here; never track it.
credentials.toml

# Certificates and credential files
*.pem
*.p12
*.pfx
service-account.json
credentials.json
*.netrc
.npmrc
.envrc

# Python bytecode caches left by the check scripts
__pycache__/
*.pyc

# Code index data
# `.ragent/` holds the Tantivy index cache the agent's code index writes; it is
# rebuilt from the sources and can be hundreds of megabytes.
.ragent/
.codemason/
!.codemason/skills/
!.codemason/blueprints/
!.codemason/templates/
!.codemason/agents/
!.codemason/Instructions/
# Defense-in-depth: the research vault holds scraped pages that can embed
# credential-shaped strings and per-vault `vault.db` files. Keep it ignored even
# if the broad `.codemason/` rule above is ever narrowed.
.codemason/research_vault/


# Credential-bearing files this codebase writes and reads. Each holds inline
# secrets: `azureresources.json` an `api_key`, an MCP config a server's `env` /
# `headers`, and the root `codemason.json` a provider credential. The root file is
# anchored (`/`) so `.codemason/codemason.json` project configs stay trackable.
azureresources.json
.mcp.json
mcp.json
/codemason.json
# The archive under assets/config/ unpacks to the same credential-bearing file;
# the root anchor above does not reach it.
assets/config/codemason.json
assets/config/codemason.json.*
# Archives are not tracked in this repo: a committed archive hides whatever it
# unpacks to (a credential-bearing config or script) from both review and
# `git grep`. If a fixture archive is genuinely needed, `git add -f` it by name.
*.zip
*.tar.gz
*.tgz
# The connector test fixtures are checked in on purpose: they are inert archive
# files the extraction and auth tests open, not credential carriers.
!assets/connectors/fixtures/archives/*.zip
!assets/connectors/fixtures/archives/*.tar.gz
*.crt
*.cer
*.der

# Node trees an installed MCP server may vendor
node_modules/

# Run logs
*.log

# Regenerable function-length analysis scratch (tools/analyze_function_lengths.py)
.func-count/

# Output of scripts/gen-spec-pdf.sh
/SPEC.pdf
